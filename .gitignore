# Secrets — never commit values
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local

# Python
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Node / Next.js
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS / IDE
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Runtime traces (redacted copies may be committed by personas; raw dumps stay local)
project-context/2.build/logs/*
!project-context/2.build/logs/.gitkeep

# Alembic generated bytecode
backend/migrations/__pycache__/
