# ARLO environment template (SAD §4 + operator LiteLLM routing).
# Copy to `.env` and fill values. Never commit `.env`.
# No production secrets belong in this file.

# ---------------------------------------------------------------------------
# AAMAD runtime adapter (required — do not leave unset; registry defaults to crewai)
# ---------------------------------------------------------------------------
AAMAD_TARGET_RUNTIME=claude-agent-sdk

# ---------------------------------------------------------------------------
# Claude Agent SDK / LiteLLM
# ANTHROPIC_API_KEY: LiteLLM virtual key when using the proxy; otherwise the
#   Anthropic API key. Never commit the real value.
# ANTHROPIC_BASE_URL:
#   - Host-run worker + local LiteLLM: http://localhost:4000
#   - Compose worker + litellm profile: http://litellm:4000
#   - Compose worker + host LiteLLM:    http://host.docker.internal:4000
#   - Direct Anthropic (no proxy):      leave empty
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=http://localhost:4000
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Optional: local LiteLLM proxy management (compose profile `litellm`)
LITELLM_MASTER_KEY=
# Upstream Anthropic key used only by the LiteLLM container (not by the worker)
LITELLM_UPSTREAM_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# PostgreSQL (ARLO metadata + mirrored audit)
# ---------------------------------------------------------------------------
POSTGRES_USER=arlo
POSTGRES_PASSWORD=arlo
POSTGRES_DB=arlo
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://arlo:arlo@localhost:5432/arlo

# Compose api/worker use the docker DNS name `postgres`:
# DATABASE_URL=postgresql://arlo:arlo@postgres:5432/arlo

# ---------------------------------------------------------------------------
# Temporal
# ---------------------------------------------------------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
ARLO_TASK_QUEUE=arlo-activities

# Compose worker/api:
# TEMPORAL_ADDRESS=temporal:7233

# ---------------------------------------------------------------------------
# FastAPI session / JWT signing (fill a long random string; never commit it)
# ---------------------------------------------------------------------------
ARLO_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# MCP — remote HTTP/SSE (leave empty when using stdio stubs)
# ---------------------------------------------------------------------------
JIRA_MCP_URL=
JIRA_MCP_TOKEN=
SNOW_MCP_URL=
SNOW_MCP_TOKEN=
JAMF_MCP_URL=
JAMF_MCP_TOKEN=
INTUNE_MCP_URL=
INTUNE_MCP_TOKEN=

# MCP — local stdio stubs (used when live tenants are unavailable)
JIRA_MCP_STDIO_CMD=
SNOW_MCP_STDIO_CMD=
JAMF_MCP_STDIO_CMD=
INTUNE_MCP_STDIO_CMD=

# ---------------------------------------------------------------------------
# Webhooks (HMAC). P1 auto-spawn is out of MVP; signature verify is still required
# if webhook ingress is enabled.
# ---------------------------------------------------------------------------
JIRA_WEBHOOK_SECRET=
SNOW_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Activity budgets (SAD §2)
# ---------------------------------------------------------------------------
ARLO_MAX_CONCURRENT_RUNS=5
INVESTIGATION_MAX_TURNS=24
INVESTIGATION_TIMEOUT_SECONDS=900
EXECUTION_MAX_TURNS=16
EXECUTION_TIMEOUT_SECONDS=900

# ---------------------------------------------------------------------------
# Embeddings — kb_articles / kb_search (SAD §4 AD-14; must yield 1536 dims)
# ---------------------------------------------------------------------------
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Local stdio MCP stub fixtures (SAD AD-10; capstone stand-ins for live tenants)
# ---------------------------------------------------------------------------
ARLO_MCP_FIXTURES_DIR=

# ---------------------------------------------------------------------------
# Build/demo verification only — smoke-test Activity (see backend.md).
# Posts one fixed diagnostic comment via the Jira MCP client at workflow
# start, outside the agent tool loop, to prove API -> Temporal -> Worker ->
# MCP -> DB wiring. Set to false to remove it from the workflow entirely.
# Automatically disabled when ARLO_JIRA_ANALYSIS_ONLY=true.
# ---------------------------------------------------------------------------
ARLO_SMOKE_TEST_ENABLED=true

# ---------------------------------------------------------------------------
# Jira-only inspect slice (operator test): read ticket, Claude analysis,
# post comment, stop. No Jamf/Intune/ServiceNow. No HITL execution.
# Requires live Jira Cloud credentials below. Restart API + worker after change.
# ---------------------------------------------------------------------------
ARLO_JIRA_ANALYSIS_ONLY=false

# ---------------------------------------------------------------------------
# Discovery + proposal lifecycle (operator test): identify Jamf vs Intune,
# read existing policies/groups/scripts/EAs, post an ADF proposal comment,
# then sleep at Awaiting Approval. No endpoint writes until human Signal.
# Wins over ARLO_JIRA_ANALYSIS_ONLY when both are true. Restart API + worker.
# ---------------------------------------------------------------------------
ARLO_JIRA_BETA_PROD=false

# Live Jira Cloud (when set, the Jira MCP server uses REST v3 instead of fixtures).
# Names only here — never commit values. Aliases: JIRA_SITE_NAME / JIRA_EMAIL / JIRA_API_TOKEN.
ATLASSIAN_SITE_NAME=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=

# ---------------------------------------------------------------------------
# Seed admin user (scripts/seed_admin.py) — optional, local/dev only
# ---------------------------------------------------------------------------
ARLO_ADMIN_USERNAME=admin
ARLO_ADMIN_PASSWORD=

# Browser origin allowed by API CORS (SAD §3 UI → FastAPI only)
FRONTEND_ORIGIN=http://localhost:3000
